# Copy this file to .env.local and fill in your values.
# Never commit .env.local to the repository.

# Turso is no longer reached from the browser. The database credential lives
# as a secret on the epsa-turso-proxy Worker, which requires a Mount Sinai
# Entra token on every route. Only the proxy's public URL belongs here.
VITE_TURSO_PROXY_URL=https://epsa-turso-proxy.your-account.workers.dev

# Azure AD (Entra ID) — required for /admin login
VITE_AZURE_CLIENT_ID=your-application-client-id
VITE_AZURE_TENANT_ID=your-directory-tenant-id

# Cloudflare Worker URL for REDCap proxy
VITE_REDCAP_PROXY_URL=https://epsa-redcap-proxy.your-account.workers.dev
