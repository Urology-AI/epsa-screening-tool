# Copy this file to .env.local and fill in your values.
# Never commit .env.local to the repository.
#
# Sessions are stored on the device only; there is no cloud database or proxy
# to configure. REDCap import is a CSV download from /admin.

# Azure AD (Entra ID) — required for /admin login
VITE_AZURE_CLIENT_ID=your-application-client-id
VITE_AZURE_TENANT_ID=your-directory-tenant-id
